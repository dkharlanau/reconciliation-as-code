{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dkharlanau/reconciliation-as-code/schema/pipeline-evidence.schema.json",
  "title": "Reconciliation as Code multi-stage pipeline evidence",
  "type": "object",
  "required": ["schema_version", "spec_version", "pipeline", "status", "configuration_sha256", "run", "stages", "transitions", "first_divergence", "summary"],
  "properties": {
    "schema_version": {"const": "1.0"}, "spec_version": {"const": 1},
    "pipeline": {"type": "string", "minLength": 1}, "description": {"type": ["string", "null"]},
    "status": {"enum": ["passed", "failed"]}, "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "run": {"type": "object", "required": ["id", "started_at", "finished_at", "duration_ms", "backend", "from_stage", "to_stage"], "properties": {"id": {"type": "string", "minLength": 1}, "started_at": {"type": "string", "minLength": 1}, "finished_at": {"type": "string", "minLength": 1}, "duration_ms": {"type": "number", "minimum": 0}, "backend": {"enum": ["python", "duckdb"]}, "from_stage": {"type": "string", "minLength": 1}, "to_stage": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "stages": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/stage"}},
    "transitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transition"}},
    "first_divergence": {"type": "array", "items": {"$ref": "#/$defs/divergence"}},
    "summary": {"type": "object", "required": ["stages_total", "transitions_total", "transitions_failed", "transitions_passed", "first_divergences", "end_to_end_executed", "end_to_end_status"], "properties": {"stages_total": {"type": "integer", "minimum": 2}, "transitions_total": {"type": "integer", "minimum": 1}, "transitions_failed": {"type": "integer", "minimum": 0}, "transitions_passed": {"type": "integer", "minimum": 0}, "first_divergences": {"type": "integer", "minimum": 0}, "end_to_end_executed": {"type": "boolean"}, "end_to_end_status": {"type": ["string", "null"]}}, "additionalProperties": true},
    "end_to_end": {"$ref": "#/$defs/transition"},
    "specification": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage": {"type": "object", "required": ["stage_id", "input_type", "path", "sha256", "status"], "properties": {"stage_id": {"type": "string", "minLength": 1}, "label": {"type": ["string", "null"]}, "input_type": {"enum": ["file", "sql"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "status": {"enum": ["baseline", "passed", "failed"]}, "incoming_transition": {"type": ["string", "null"]}}, "additionalProperties": true},
    "transition": {"type": "object", "required": ["id", "from", "to", "status", "summary", "checks", "evidence"], "properties": {"id": {"type": "string", "minLength": 1}, "from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "failed"]}, "run_id": {"type": ["string", "null"]}, "duration_ms": {"type": ["number", "null"]}, "summary": {"type": "object"}, "checks": {"type": "array", "items": {"type": "object"}}, "evidence": {"type": "object"}}, "additionalProperties": true},
    "divergence": {"type": "object", "required": ["identity", "check_id", "locator", "first_transition", "from_stage", "to_stage", "transition_index", "detail"], "properties": {"identity": {"$ref": "#/$defs/sha256"}, "check_id": {"type": ["string", "null"]}, "check_type": {"type": ["string", "null"]}, "severity": {"type": ["string", "null"]}, "locator": {"type": "object"}, "first_transition": {"type": "string", "minLength": 1}, "from_stage": {"type": "string", "minLength": 1}, "to_stage": {"type": "string", "minLength": 1}, "transition_index": {"type": "integer", "minimum": 0}, "detail": {"type": "object"}}, "additionalProperties": true}
  },
  "additionalProperties": true
}
